# Copy to .env.local. This key is read by the server only (app/api/chat/route.ts).
GEMINI_API_KEY=

# Optional. Pins a single model. By default the route tries gemini-3.6-flash,
# then gemini-3.1-flash-lite if the first is overloaded or unavailable.
# Older IDs such as gemini-2.5-flash return 404 for new API keys.
# GEMINI_MODEL=gemini-3.6-flash

# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Where the SENTINEL engine listens. The Monitor page reaches it through
# the /engine/* rewrite in next.config.ts, read when `next dev` or `next build` runs.
# SENTINEL_URL=http://127.0.0.1:8787

# Limits on requests that spend the server's Gemini key (those sent without a user key).
# Counted in memory per server instance: each instance has its own budget and a restart
# resets it. By default every request counts as one client, so SERVER_KEY_RATE_LIMIT is
# shared by everyone. The total holds either way.
# SERVER_KEY_RATE_LIMIT=20
# SERVER_KEY_RATE_LIMIT_TOTAL=200
# SERVER_KEY_RATE_WINDOW_SECONDS=60

# Optional. Counts each client on its own, by the first address in X-Forwarded-For.
# Set it to true only when the app runs behind an ingress that replaces that header with
# the address it saw. Without one, a client can send a new address with every request
# and never reach its limit. Any other value leaves it off.
# TRUST_FORWARDED_FOR=true
