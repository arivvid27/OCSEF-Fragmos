# Copy to .env and fill in. Never commit .env.
OPENCODE_API_KEY=
# Optional overrides
SENTINEL_CLOUD_MODEL=
SENTINEL_LOCAL_BASE_URL=
SENTINEL_LOCAL_MODEL=
SENTINEL_LOCAL_API_KEY_ENV=
# Browser origins that may open /ws and decide approvals, comma separated.
# Default: http://127.0.0.1:3000,http://localhost:3000 (the web app's monitor)
SENTINEL_ALLOWED_ORIGINS=
# The base URL clients are told to use, shown by GET /api/gateway. Display only: the engine still accepts loopback only.
# Default: http://127.0.0.1:8787
SENTINEL_PUBLIC_URL=
